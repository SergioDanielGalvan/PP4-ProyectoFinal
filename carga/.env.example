DB_HOST=10.0.0.16
DB_PORT=3306
# usuario con escritura
DB_ADMIN_USER=comex_admin
DB_ADMIN_PASSWORD=cambiar-admin
DB_NAME=comex
# true para TiDB Cloud (exige TLS)
DB_SSL=false

# ruta al Kit.mdb para npm run kit
KIT_MDB=../access/Kit.mdb

# Líneas por cada LOAD DATA (opcional; bajar si el servidor corta la conexión)
# LINEAS_POR_LOTE=500000

# --- Copia a TiDB Cloud (npm run tidb) ---
# Datos del botón Connect de la instancia; el usuario lleva el prefijo (xxxx.root)
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=prefijo.root
TIDB_PASSWORD=cambiar-tidb
TIDB_DB=comex
# Opcionales: filas por INSERT e INSERT simultáneos
# TIDB_FILAS_POR_INSERT=5000
# TIDB_PARALELO=3
