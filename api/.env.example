PORT=3000

DB_HOST=10.0.0.16
DB_PORT=3306
# usuario de sólo lectura
DB_USER=comex_api
DB_PASSWORD=cambiar-api
DB_NAME=comex
DB_POOL=10
# true para TiDB Cloud (exige TLS). Para TiDB:
#   DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com  DB_PORT=4000
#   DB_USER=prefijo.comex_api  (sólo SELECT)
DB_SSL=false

# false = rutas de importación abiertas (modo prueba, sin login)
AUTH_ENABLED=false

# production oculta el detalle de los errores de base en las respuestas
NODE_ENV=development
