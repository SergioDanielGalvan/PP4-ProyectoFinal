{
  "name": "comex-impo-api",
  "version": "0.1.0",
  "description": "API REST y página de consulta de las estadísticas de importación (ARCA)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "usuario": "node scripts/crear-usuario.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integracion": "node --test --test-concurrency=1 \"test/integracion/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
